# --- Database (Prisma + PostgreSQL) ---
# Local dev:  `npx prisma dev` prints a ready-to-use URL, or point at any
# Postgres. Production: Neon / Supabase / Vercel Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/marquee"

# --- Admin API (Gate 2) ---
# Shared secret for /api/admin/* scaffold auth (header: x-admin-secret).
# Used by API clients / e2e tests only — the /admin/* browser UI uses the
# session login below instead.
ADMIN_API_SECRET="change-me"

# --- Admin session login (app/admin/login) ---
# ADMIN_PASSWORD: password for the single-admin login form. Set a strong
# value in production — this file's blank default fails closed.
# ADMIN_PASSWORD=""
# SESSION_SECRET: HS256 signing key for the admin_session JWT cookie (jose).
# Use a long random string (e.g. `openssl rand -base64 32`) in production.
# SESSION_SECRET=""

# --- Waitlist (existing) ---
# KLAVIYO_API_KEY=""
# KLAVIYO_LIST_ID=""
# BLOB_READ_WRITE_TOKEN is injected by the linked Vercel Blob store (PRIVATE —
# blobs there need a token to read; used by lib/waitlist.ts).
# PHOTOS_READ_WRITE_TOKEN: a SECOND, PUBLIC Blob store, used only for
# customer pet photos (app/api/orders/upload-token/route.ts). It has to be a
# separate store because a store's access mode is fixed at creation and the fal
# generation models must be able to fetch each photo by plain URL.
# PHOTOS_READ_WRITE_TOKEN=""

# --- Order-lifecycle email (lib/mocks.ts) ---
# Provider chain: Klaviyo (if KLAVIYO_API_KEY set) -> Resend (if RESEND_API_KEY
# set) -> console.log mock. Klaviyo tracks a custom event ("Storyboard Ready" /
# "Film Delivered") for an Owner-built Flow to send; Resend sends the HTML
# authored in lib/mocks.ts directly — pick ONE, no code changes needed either way.
# KLAVIYO_API_KEY="" (reuses the same key as the waitlist above)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Marquee Tails <hello@yourdomain.com>" # must be a Resend-verified domain

# --- Director's Cut safety net (B2 — lib/safety-net.ts) ---
# Where the "customer requested the refund" alert goes (sendRefundRequestedAlert
# in lib/mocks.ts) so a human can issue it by hand in the Stripe dashboard —
# this app never calls Stripe's refund API. Unset -> falls back to support@marqueetails.com.
# ADMIN_ALERT_EMAIL=""

# --- Video pipeline ---
# FAL_KEY: fal.ai API key. VIDEO_PIPELINE_MOCK=1 skips real generation (dev/e2e).
# APP_BASE_URL: public base URL for email/approval links (Vercel URL in prod).
# KLING_MODEL: overrides the fal Kling endpoint id (lib/film-pipeline.ts).
# Unset -> defaults to the "pro" tier, adopted for tighter start-frame
# adherence after a profile-drift production incident. Pro costs more per
# second than standard — set this to the v3/standard/image-to-video path to
# A/B or roll back instantly without a code deploy.
# KLING_MODEL="fal-ai/kling-video/v3/pro/image-to-video"

# --- Claude (Director's Cut / custom plan — lib/claude-script.ts) ---
# ANTHROPIC_API_KEY: unset -> getAnthropicClient() returns null (generateTreatment
# throws; callers revert the same way as a stills-kick failure). VIDEO_PIPELINE_MOCK=1
# short-circuits to a canned bundle regardless, so local/dev never needs a real key.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- Trigger.dev v4 (offloads film/poster/rerender generation off Vercel Hobby) ---
# TRIGGER_SECRET_KEY="" # dashboard API key. Unset -> kick*Generation runs inline
# (local dev / owner's real-generation testing on localhost, unchanged). Set (on
# Vercel) -> kicks are offloaded to Trigger.dev via tasks.trigger(). The tasks
# themselves (./trigger/*.ts) also need DATABASE_URL and FAL_KEY, but those are
# configured separately in the Trigger.dev dashboard's Environment Variables —
# NOT read from this file. Do not set VIDEO_PIPELINE_MOCK there (prod = real
# generation). See FILM-ASYNC-SPEC.md.

# --- Stripe (payment plumbing) ---
# Test-mode keys from the Stripe Dashboard. Create 2 one-time Prices
# (Preset Worlds $99 / Director's Cut $249) and paste their Price IDs below.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PRESET=""
# STRIPE_PRICE_CUSTOM=""
# Post-delivery add-ons (Printed Poster $59 / Gallery Canvas $99) — the
# SECOND Stripe Checkout, offered at COMPLETED (lib/stripe.ts getAddonPriceId,
# app/api/addon-checkout/route.ts). Create 2 one-time Prices and paste their
# Price IDs below.
# STRIPE_PRICE_ADDON_POSTER=""
# STRIPE_PRICE_ADDON_CANVAS=""

# --- Printify POD (post-delivery poster/canvas add-on) ---
# Fires from the add-on Checkout webhook once a physical add-on is purchased
# (lib/printify.ts, lib/mocks.ts createPodOrder). Confirm blueprint/provider/
# variant IDs during the Printify test before setting these in production.
# PRINTIFY_API_KEY=""             # Personal Access Token: printify.com/app/account/api
# PRINTIFY_SHOP_ID=""             # GET /v1/shops.json で確認
# PRINTIFY_BLUEPRINT_POSTER=""    # Printed Poster add-on用blueprint_id
# PRINTIFY_PROVIDER_POSTER=""
# PRINTIFY_VARIANT_POSTER=""
# PRINTIFY_BLUEPRINT_CANVAS=""    # Gallery Canvas add-on用 16x24 blueprint_id
# PRINTIFY_PROVIDER_CANVAS=""
# PRINTIFY_VARIANT_CANVAS=""
