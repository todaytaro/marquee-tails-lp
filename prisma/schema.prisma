// Marquee Tails — order state machine
//
// The 2-Gate system: statuses may ONLY move forward along ALLOWED_TRANSITIONS
// (see lib/orders.ts — the single choke point for every status change).
// Gate 1 = customer approves one concept still (before any video compute).
// Gate 2 = admin approves the finished video (before delivery + POD).
//
// Prisma 7: connection URL lives in prisma.config.ts, client is generated
// into /generated/prisma and constructed with a driver adapter (lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  UPLOADING // initial: photos being uploaded
  IMAGE_GENERATING // AI generating concept stills
  AWAITING_CUSTOMER_APPROVAL // Gate 1: customer picks one still
  VIDEO_GENERATING // video pipeline running (only after Gate 1)
  AWAITING_ADMIN_APPROVAL // Gate 2: admin quality check
  COMPLETED // delivered + POD ordered
}

model Order {
  id             String      @id @default(cuid())
  shopifyOrderId String      @unique
  customerEmail  String
  status         OrderStatus @default(UPLOADING)

  // intake
  petName           String?
  world             String? // deepspace | storybook | noir
  uploadedPhotoUrls String[] @default([])

  // Gate 1 artifacts
  conceptImageUrls String[] @default([]) // generated stills the customer picks from
  selectedImageUrl String? // the approved still (set at Gate 1)

  // Gate 2 artifacts
  finalVideoUrl String? // 16:9 master, set by the film pipeline, held until admin approval
  socialVideoUrl String? // 9:16 social cut, delivered alongside the master
  adminNote     String?
  falRequestId  String? // fal.ai queue request id (debugging / reconciliation)

  // identity lock (stills pipeline v2)
  petDescription      String? // VLM-extracted distinguishing features, injected into prompts
  personality         String? // brave / easygoing / playful / timid — picks the story arc
  identityPortraitUrl String? // neutral close-up generated from photos; ref for all takes

  // film pipeline checkpoints — lets a run resume after an upload/balance
  // failure without re-spending compute on already-generated assets.
  // { heroSheet?, shotStillUrls?, clipUrls?, scoreUrl? }
  filmArtifacts Json?

  // customer-facing approval links authenticate with this token, not a login
  approveToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents StatusEvent[]

  @@index([status])
}

// Append-only audit log of every transition (chargeback/dispute evidence,
// per requirements.md §5 監査ログ).
model StatusEvent {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from    OrderStatus
  to      OrderStatus
  actor   String // "customer" | "admin" | "system"
  note    String?

  createdAt DateTime @default(now())

  @@index([orderId])
}
