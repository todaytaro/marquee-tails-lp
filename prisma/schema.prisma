// Marquee Tails — order state machine
//
// The 2-Gate system: statuses may ONLY move forward along ALLOWED_TRANSITIONS
// (see lib/orders.ts — the single choke point for every status change).
// Gate 1 = customer approves one concept still (before any video compute).
// Gate 2 = admin approves the finished video (before delivery + POD).
//
// Prisma 7: connection URL lives in prisma.config.ts, client is generated
// into /generated/prisma and constructed with a driver adapter (lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  UPLOADING // initial: photos being uploaded
  IMAGE_GENERATING // AI generating concept stills
  AWAITING_CUSTOMER_APPROVAL // Gate 1: customer picks one still
  VIDEO_GENERATING // video pipeline running (only after Gate 1)
  AWAITING_ADMIN_APPROVAL // Gate 2: admin quality check
  COMPLETED // delivered + POD ordered
  FAILED // film generation failed after retries — awaiting admin retry
  // B2 (Director's Cut safety net): the terminal state after a manual refund
  // is recorded (AWAITING_CUSTOMER_APPROVAL -> CANCELLED, see
  // lib/orders.ts). A refund is an attribute of an order, not a new stage —
  // this reuses CANCELLED rather than adding an enum value (B2-SAFETY-NET-
  // SPEC.md §2/§4.3). No other flow transitions in/out.
  CANCELLED
  // --- Director's Cut (custom) — B1 "Gate 0" ---
  TREATMENT_GENERATING // custom only: Claude is drafting/redrafting the treatment
  AWAITING_TREATMENT_APPROVAL // custom only: customer reads the treatment, approves or asks for changes
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  customerEmail   String
  status          OrderStatus @default(UPLOADING)
  tier            String? // "digital" | "feature" | "collector" — Stripe決済完了時に確定
  amountPaidCents Int? // 監査用: 実際にStripeで決済された金額（session.amount_total）

  // intake
  petName           String?
  world             String? // deepspace | storybook | noir
  uploadedPhotoUrls String[] @default([])

  // Gate 1 artifacts — the storyboard the customer approves (6 cuts × 3 takes).
  // storyboardOptions: [{ scene, options: [url,url,url] }] in cut order; the
  // wizard shows one page per cut. conceptImageUrls keeps the FLAT list of all
  // 18 takes (approval-API whitelist + backwards compatibility).
  storyboardOptions Json? // [{ scene: string; options: string[] }] — the 6-cut picker
  chosenStills      String[] @default([]) // the 6 approved takes, one per cut, in cut order
  conceptImageUrls  String[] @default([]) // flat list of every generated take (whitelist)
  selectedImageUrl  String? // cut 1's approved take (poster for filming/QC views)

  // Poster (the hero product): at Gate 1 the customer marks which approved cut
  // becomes the poster scene; 3 finished poster candidates (2:3 key art with
  // typography composited locally) generate alongside the film; the customer
  // picks ONE while the cameras roll. posterUrl is the deliverable (POD).
  posterCutIndex Int? // which chosenStills index seeds the poster scene
  posterOptions  String[] @default([]) // 3 finished poster candidates
  posterUrl      String? // the customer's pick (text-free art) — the on-screen product
  posterPrintUrl String? // flattened print-ready PNG of posterUrl (title block baked in via satori), rendered at Gate 2 approval — this is what ships to POD

  // Gate 2 artifacts
  finalVideoUrl  String? // 16:9 master, set by the film pipeline, held until admin approval
  // DEPRECATED — no longer written. The 9:16 cut was a centre crop of the
  // master (68% of the frame width discarded) and shipped a worse video than
  // the customer would get by posting the 16:9 to TikTok themselves, so the
  // pipeline stopped producing one (lib/film-pipeline.ts#assembleToFiles).
  // The COLUMN stays: orders delivered before that have real URLs here and
  // dropping it would destroy delivered work for no benefit. Read-only now.
  socialVideoUrl String?
  adminNote      String?
  falRequestId   String? // fal.ai queue request id (debugging / reconciliation)
  failureReason  String? // set when status=FAILED; cleared on retry

  // Per-shot identity audit (film pipeline) — the video identity gate scores
  // each animated clip against the identity portrait so drift ("this cut isn't
  // my dog") is caught automatically and surfaced to the admin at Gate 2.
  shotClipUrls       String[] @default([]) // the 6 per-shot clips, in cut order (admin spot-check)
  shotIdentityScores Int[]    @default([]) // per-shot clip identity score 0-100, in cut order

  // identity lock (stills pipeline v2)
  petDescription      String? // VLM-extracted distinguishing features, injected into prompts
  personality         String? // brave / easygoing / playful / timid — picks the story arc
  identityPortraitUrl String? // neutral close-up generated from photos; ref for all takes
  heroSheetUrl        String? // costumed reference sheet — anchor for takes & admin re-shoots

  // --- LoRA storyboard (B1) — LORA-STORYBOARD-SPEC.md §2.1 ---
  // One LoRA trained per order from the customer's own photos, used by every
  // take (initial storyboard, customer re-rolls, admin re-shoots) via
  // fal-ai/flux-2/lora/edit instead of the older reference-chain approach.
  // Trained ONCE — set together, both null until training succeeds; a null
  // loraUrl means every take for this order falls back to the pre-B1
  // nano-banana costume chain (training failed, or predates this feature).
  loraUrl         String? // trained LoRA weights file url (fal storage)
  loraTriggerWord String? // rare order-unique trigger word the LoRA was trained on; reused verbatim in every B1 take prompt

  // film pipeline checkpoints — lets a run resume after an upload/balance
  // failure without re-spending compute on already-generated assets.
  // { heroSheet?, shotStillUrls?, clipUrls?, scoreUrl? }
  filmArtifacts Json?

  // Shipping — filled by the ADD-ON checkout (physical poster/canvas
  // purchase, post-delivery), not the base plan checkout. Base plans are
  // video + digital poster only, so no address is collected at base
  // checkout. Stripe Checkout の shipping_address_collection から埋める想定。
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingRegion     String? // state/province
  shippingPostalCode String?
  shippingCountry    String? // ISO 3166-1 alpha-2 (e.g. "US")

  // Printify連携の監査用 — populated once the physical add-on's Printify
  // order fires (see addonType below); no physical good exists before that.
  podOrderId String? // PrintifyのオーダーID（サポート対応・突合用）
  podStatus  String? // Printifyから最後に確認できたステータス(任意のキャッシュ、無くても動く)

  // --- Physical add-on (Pass 2 — post-delivery upsell) ---
  // The digital poster ships free with every plan. The printed poster /
  // gallery canvas are an optional SECOND purchase after delivery
  // (status COMPLETED), via their own Stripe Checkout + Printify order.
  // One physical add-on per order in this pass. Shipping is collected at the
  // add-on Checkout and lands in the existing shipping* columns; the Printify
  // order id/status reuse the existing podOrderId/podStatus columns.
  addonType            String? // "poster" | "canvas"
  addonStripeSessionId String?   @unique // the 2nd Checkout session — idempotency key
  addonPaidCents       Int? // audit: session.amount_total of the add-on
  addonPurchasedAt     DateTime?

  // --- Director's Cut (custom) — B1 ---
  // The customer's free-text brief (guided fields concatenated). Claude turns
  // this into a "world bundle" (generatedScript) equivalent to a static entry
  // in lib/film-script.ts, plus a human-readable treatment shown for approval.
  customBrief            String? // guided brief (setting/mood/highlight/ending)
  generatedScript        Json? // Claude's structured world bundle (see lib/claude-script.ts WorldBundle)
  treatmentText          String? // human-readable treatment shown at the approval gate
  treatmentRevisionCount Int     @default(0) // internal abuse cap only (NOT a customer-facing limit)
  // world/personality stay nullable and are simply unused for custom orders.

  // --- Director's Cut safety net — B2 ---
  // PRICING-PRODUCT-V2-SPEC.md §3.5(C)'s "hybrid" promise: three free Gate-1
  // storyboard re-rolls, then a refund (of the $249 custom price; the
  // concept & storyboard fee stays non-refundable — see REFUND_AMOUNT_USD /
  // NONREFUNDABLE_FEE_USD in lib/safety-net.ts for the current figures) if
  // the customer still can't approve before filming. Custom ($249) only —
  // Preset ($99) has no Gate 0 and no fee/refund split, so these three
  // columns are simply unused (always 0/null) on a preset row
  // (B2-SAFETY-NET-SPEC.md §7).
  storyboardRerollCount Int       @default(0) // Gate 1 free re-rolls spent (order-wide, cap in lib/safety-net.ts STORYBOARD_REROLL_CAP)
  refundRequestedAt     DateTime? // customer asked for the refund (§4.2) — set once, never cleared
  refundIssuedAt        DateTime? // admin recorded the refund as actually issued IN STRIPE'S DASHBOARD (§4.3) — this app never calls Stripe's refund API and never computes the amount

  // --- Admin storyboard gate — STORYBOARD-ADMIN-GATE-SPEC.md §3.3/§4 ---
  // How many times ADMIN (not the customer) has re-rolled a cut while the
  // storyboard sat in the IMAGE_GENERATING review queue, before ever showing
  // it to the customer. Deliberately a SEPARATE column from
  // storyboardRerollCount above: an admin re-roll fixing our own quality miss
  // must never spend the customer's 3-free-reroll/refund budget (§3.3a).
  // It also seeds a disjoint seed band from the customer's re-rolls
  // (adminRerollSeedBase in lib/stills-pipeline.ts, §3.3b) so the two can
  // never draw the same image for the same cut.
  adminRerollCount Int @default(0)

  // --- 納品評価（DELIVERY-RATING-SPEC.md）---
  ratingStars   Int? // 1-5。null = まだ評価していない
  ratingComment String? // 任意の自由記述（最大2000字、空文字はnullで保存）
  ratedAt       DateTime? // 最終送信時刻。顧客は星を変更できるので「最初」ではない

  // customer-facing approval links authenticate with this token, not a login
  approveToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents   StatusEvent[]
  evidenceEvents EvidenceEvent[]

  @@index([status])
}

// Append-only audit log of every transition (chargeback/dispute evidence,
// per requirements.md §5 監査ログ).
model StatusEvent {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from    OrderStatus
  to      OrderStatus
  actor   String // "customer" | "admin" | "system"
  note    String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// CHARGEBACK-DEFENSE-SPEC.md §3 — StatusEvent above only covers state
// TRANSITIONS (from/to required); a download, a poster pick, or a re-roll
// doesn't transition anything, so none of that customer-operated evidence had
// anywhere to live. This is StatusEvent's sibling, not a replacement: append-
// only, never mutated, one row per recorded action, kept even after an order
// reaches a terminal state. See lib/evidence.ts#recordEvidence for the single
// writer (never throws — a failed insert must not break the flow it's
// attached to).
model EvidenceEvent {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String // see lib/evidence.ts's EvidenceKind for the closed set of values
  detail    Json? // kind-specific structured data (chosen storyboard URLs, consent text shown, etc.)
  ip        String? // first hop of x-forwarded-for, customer-operated kinds only (never set for webhook/system kinds)
  userAgent String?

  createdAt DateTime @default(now())

  @@index([orderId])
}
