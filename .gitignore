# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# waitlist signups (PII, dev-only JSONL fallback)
.waitlist/

# env files
.env*
!.env.example

# waitlist local fallback storage (contains emails — never commit)
/.waitlist/
/generated

# trigger.dev local dev runtime state
/.trigger/

# claude code local launch config
/.claude/

# NOTE: public/sfx/*.wav is deliberately NOT ignored. The trailer's SFX bed is
# mixed by ffmpeg inside the Trigger.dev task, so the files must reach that
# build via trigger.config.ts additionalFiles — and they can only get there if
# git carries them. Ignoring them would leave production silently falling back
# to the no-SFX mix on every order, i.e. the exact cheap-sounding result the
# beat-edit rework existed to fix. Royalty-free sources only (public/sfx/README.md).
